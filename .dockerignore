# Dependencias (se instalan/compilan dentro de la imagen)
/vendor
/node_modules

# Secretos — nunca deben terminar dentro de la imagen
.env
.env.*
!.env.example
!env.production.example

# Runtime / datos — no van en la imagen (salvo storage/app/public, ver abajo)
/database/*.sqlite
/database/*.sqlite-*
/database/.sqlite-data
/storage/app/*
!/storage/app/.gitignore
# Imágenes del sitio (logo, capturas, collages): van dentro de la imagen.
!/storage/app/public
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/framework/testing/*
/storage/logs/*
/bootstrap/cache/*
!/bootstrap/cache/.gitignore

# Control de versiones / entorno local
.git
.gitignore
.gitattributes
.editorconfig
.phpunit.result.cache

# Assets de build de Vite (se generan en la etapa "assets", no hace
# falta que vengan del contexto de build)
/public/build
/public/hot

# Cosas del desarrollador, no del proyecto
ema.sh
/scripts
*.tar.gz

# Documentación (no afecta el funcionamiento, no hace falta en la imagen)
/docs

# Notas, pruebas y herramientas de desarrollo (no se usan en producción)
/tests
phpunit.xml
tarea.md
CLAUDE.md
AGENTS.md
/.claude
/.agents
.mcp.json
boost.json
docker-compose*.yml
