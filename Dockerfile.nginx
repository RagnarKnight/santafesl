# syntax=docker/dockerfile:1
# =============================================================================
# Sant fe — Dockerfile.nginx (contenedor "web")
# =============================================================================

FROM node:22.23.4-slim AS node-builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .

RUN npm run build && rm -f public/storage

FROM nginx:alpine

COPY nginx/nginx.conf /etc/nginx/nginx.conf
COPY nginx/default.conf /etc/nginx/conf.d/default.conf

# public/ completo (index.php incluido: `try_files $uri =404` lo comprueba acá
# antes de pasarlo a PHP-FPM). public/storage apunta al volumen de imágenes.
COPY --from=node-builder /app/public /var/www/html/public
RUN rm -f /var/www/html/public/storage \
    && mkdir -p /var/www/html/storage/app/public \
    && ln -s ../storage/app/public /var/www/html/public/storage

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD wget -q --spider http://127.0.0.1:8080/up || exit 1
