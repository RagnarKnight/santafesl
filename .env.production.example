# Copiar a .env.production (NO se versiona ni entra en la imagen) y completar APP_KEY:
#   echo "base64:$(openssl rand -base64 32)"
APP_NAME=SantaFeSL
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Dirección pública con https (la que sirve el Nginx del host).
APP_URL=https://santafesl.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

# Logs a la salida del contenedor: `docker compose logs app`.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Canales de contacto (config/site.php). En producción se muestran los reales.
SITE_CONTACT_EMAIL=
SITE_CONTACT_WHATSAPP=
SITE_CONTACT_WHATSAPP_MESSAGE="Hola, quiero consultar por los servicios de SantaFeSL."
