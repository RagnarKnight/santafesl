APP_NAME=SantaFeSL
# DESARROLLO. En producción: APP_ENV=production, APP_DEBUG=false y APP_URL con https
# (ver docs/manual/07-produccion.md). Con APP_ENV=local no se aplican las cabeceras CSP.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# La versión 1 no usa base de datos: sesión, caché y colas no dependen de ella.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

VITE_APP_NAME="${APP_NAME}"

# Canales de contacto: única fuente (config/site.php los lee de acá).
# Los valores de abajo son EJEMPLOS ficticios: en desarrollo se muestran marcados como
# "ejemplo" y en producción (APP_ENV=production) NO se muestran. Reemplazalos antes de publicar.
# Un canal vacío no se muestra. Guía completa: docs/manual/04-contacto.md
SITE_CONTACT_EMAIL=contacto@example.com
# Solo dígitos con código de país, sin "+", espacios ni paréntesis (ejemplo ficticio).
SITE_CONTACT_WHATSAPP=5490000000000
# Mensaje con el que se abre el chat de WhatsApp (opcional).
SITE_CONTACT_WHATSAPP_MESSAGE="Hola, quiero consultar por los servicios de SantaFeSL."
